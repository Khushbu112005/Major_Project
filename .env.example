# CivicSphere Module C Environment Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=CivicSphere-Knowledge-Engine
API_PREFIX=/api/v1

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET_KEY=change-this-in-production-use-a-strong-random-key-32-bytes
JWT_ALGORITHM=HS256
MAX_SOURCE_SIZE_BYTES=5242880

# Ingestion Security / SSRF Protections
SSRF_PROTECTION_ENABLED=true
ALLOWED_INGESTION_SCHEMES=["http","https"]
FETCH_TIMEOUT_SECONDS=10.0
MAX_REDIRECTS=3

# Database & Graph
DATABASE_URL=sqlite+aiosqlite:///./civicsphere_knowledge.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=civicsphere_secret
NEO4J_DATABASE=neo4j
NEO4J_MAX_DEPTH=3
NEO4J_DEFAULT_DEPTH=2
NEO4J_MAX_NEIGHBORS=10

# AI Provider Configurations
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
LLM_PROVIDER=mock
LLM_MODEL=claude-3-5-sonnet-20241022
RERANKER_PROVIDER=heuristic

# Retrieval Parameters
DEFAULT_TOP_K=5
MAX_TOP_K=25
RRF_K=60
EVIDENCE_CONFIDENCE_THRESHOLD_STRONG=0.90
EVIDENCE_CONFIDENCE_THRESHOLD_GOOD=0.75
EVIDENCE_CONFIDENCE_THRESHOLD_LIMITED=0.50
